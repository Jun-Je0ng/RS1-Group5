<sdf version="1.7">
  <model name="forest_terrain">
    <static>true</static>
    <link name="link">

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://forest_terrain/materials/textures/Elevated_Terrain_Test.dae</uri>
            <scale>30 30 30</scale>  <!-- make the mesh large enough -->
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://forest_terrain/materials/textures/Elevated_Terrain_Test.dae</uri>
            <scale>30 30 30</scale>
          </mesh>
        </geometry>

        <!-- Force a texture, regardless of what's inside the .dae -->
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <double_sided>true</double_sided>
          <pbr>
            <metal>
              <albedo_map>model://forest_terrain/materials/textures/forest_overhead.png</albedo_map>
              <!-- Optional, but helps lighting look sane -->
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>


    </link>
  </model>
</sdf>


